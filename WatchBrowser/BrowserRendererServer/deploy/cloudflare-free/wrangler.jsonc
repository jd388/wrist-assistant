{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "watchbrowser-free",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    // Make the incoming request.signal reflect client disconnects so the
    // Worker can cancel an in-flight DeepSeek response stream immediately.
    "enable_request_signal"
  ],
  "workers_dev": true,
  "secrets": {
    "required": [
      "BROWSER_RENDERER_TOKEN",
      "DEEPSEEK_API_KEY"
    ]
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BROWSER_SESSION",
        "class_name": "BrowserSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BrowserSession"]
    }
  ]
}
